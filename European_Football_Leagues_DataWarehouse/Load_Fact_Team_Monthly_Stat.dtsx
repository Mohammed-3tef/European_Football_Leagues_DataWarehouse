                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    m.season_id, 
    m.league_id,
    m.utc_date,
    m.home_team_id,
    m.away_team_id,
    s.full_time_home,
    s.full_time_away,
    m.updated_at,
    m.winner
FROM matches m
JOIN scores s ON m.match_id = s.match_id
WHERE m.updated_at &gt; ?
  AND m.updated_at &lt; DATEFROMPARTS(YEAR(GETDATE()), MONTH(GETDATE()), 1)</property>
