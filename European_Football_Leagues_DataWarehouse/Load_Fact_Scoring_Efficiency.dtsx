                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    m.season_id AS Season_key,
    m.league_id AS League_key,
    m.utc_date AS Match_Date_key,
    m.home_team_id,
    m.away_team_id,
    s.score_id,
    s.half_time_home,
    s.half_time_away,
    s.full_time_home,
    s.full_time_away
FROM matches m
JOIN scores s ON m.match_id = s.match_id
WHERE s.updated_at &gt; ? OR m.updated_at &gt; ?</property>
